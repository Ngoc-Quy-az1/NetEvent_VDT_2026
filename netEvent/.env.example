# ==========================================
# GENERAL & COMMON CONFIGURATION
# ==========================================
# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=postgrespassword

# ClickHouse Configuration (KPI Telemetry Data)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=kpi_db
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhousepassword

# Specific Database Names for Microservices
ADAPTER_DB_NAME=adapter_db
NOTIFICATION_DB_NAME=notification_db

# Kafka & Redis Configuration
KAFKA_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# MICROSERVICE PORTS
# ==========================================
MINI_BUSINESS_SERVICE_PORT=8080
NOTIFICATION_ADAPTER_PORT=8081
ROUTING_SERVICE_PORT=8082
SMS_WORKER_PORT=8083
EMAIL_WORKER_PORT=8084
OTT_WORKER_PORT=8085
AUDIT_SERVICE_PORT=8086
EVENT_PROCESSOR_PORT=8087
DISPATCHER_SERVICE_PORT=8089

# ==========================================
# NOTIFICATION ADAPTER & SIMULATOR
# ==========================================
SCHEDULER_ENABLED=false
SCHEDULER_RATE_MS=60000
NOTIFICATION_ADAPTER_URL=http://localhost:8081/api/v1/events/ingest
SCHEDULER_PROFILE_NAME=COVERAGE_ALERT_RANDOM_DOMAINS

# ==========================================
# EMAIL / SMTP CONFIGURATION
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ==========================================
# TELEGRAM / OTT BOT CONFIGURATION
# ==========================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-100123456789

# ==========================================
# SMS GATEWAY CONFIGURATION
# ==========================================
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret

# ==========================================
# SECURITY & WEBHOOK SECRET
# ==========================================
WEBHOOK_HMAC_SECRET=dev_secret_key_12345
