erDiagram
    site {
        uuid site_id PK
        varchar station_code UK
        varchar area_code
        varchar province_code
        numeric longitude
        numeric latitude
        timestamptz created_at
        timestamptz updated_at
    }

    cell {
        uuid cell_id PK
        varchar cell_code UK
        uuid site_id FK
        varchar device_code
        varchar sector
        varchar network
        varchar vendor
        int4 ci_serving_cell
        int4 lac_tac
        timestamptz created_at
        timestamptz updated_at
    }

    cell_session {
        uuid cell_session_id PK
        uuid cell_id FK
        uuid session_id FK
        timestamptz created_at
        timestamptz updated_at
    }

    event_session {
        uuid session_id PK
        varchar session_event_code UK
        uuid event_id FK
        timestamptz start_date
        timestamptz end_date
        timestamptz lunar_start_date
        timestamptz lunar_end_date
        int4 expected_participants
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    event {
        uuid event_id PK
        varchar event_code UK
        varchar event_name
        uuid event_type_id FK
        uuid holiday_id FK
        varchar event_level
        boolean annual
        boolean is_lunar
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    holiday_occasion {
        uuid holiday_id PK
        varchar holiday_code UK
        varchar holiday_name
    }

    event_type {
        uuid event_type_id PK
        varchar event_type_code UK
        varchar event_type_name
    }

    profile_event_session {
        uuid profile_id PK_FK
        uuid session_id PK_FK
    }

    profile {
        uuid profile_id PK
        varchar profile_name UK
        varchar display_name
        varchar display_name_ui
        varchar status
        varchar cron_expression
        boolean require_approval
        timestamptz start_time
        timestamptz end_time
        timestamptz created_at
        timestamptz updated_at
    }

    account {
        uuid account_id PK
        varchar username UK
        varchar full_name
        varchar email UK
        varchar cell_phone
        varchar area_code
        varchar language
        int2 role_id
        timestamptz last_login
        boolean deleted
        timestamptz created_at
        timestamptz updated_at
    }

    profile_account {
        uuid profile_id PK_FK
        uuid account_id PK_FK
    }

    profile_channel {
        uuid profile_id PK_FK
        uuid channel_id PK_FK
    }

    channel {
        uuid channel_id PK
        varchar channel_code UK
        varchar channel_name
    }

    template {
        uuid template_id PK
        uuid channel_id FK
        varchar template_name
        varchar queue_name
        jsonb config
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    notification_event {
        uuid notification_event_id PK
        uuid profile_id FK
        uuid event_id FK
        jsonb raw_event_payload
        varchar status
        timestamptz received_at
        timestamptz processed_at
    }

    business_rule {
        uuid business_rule_id PK
        varchar business_rule_code UK
        varchar business_rule_name
        varchar source_db_type
        varchar source_host
        int4 source_port
        varchar source_database
        varchar source_schema
        varchar source_table
        varchar source_connection_ref
        text sql_query
        text description
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    profile_business_rule_mapping {
        uuid profile_id PK_FK
        uuid business_rule_id PK_FK
        varchar status
        timestamptz created_at
        timestamptz updated_at
    }

    notification {
        uuid notification_id PK
        uuid notification_event_id
        uuid profile_id
        text contents
        jsonb context_data
        varchar status
        timestamptz created_at
    }

    routing_template {
        uuid routing_template_id PK
        uuid channel_id
        uuid profile_id
        text content
        int4 version
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }

    recipient {
        uuid recipient_id PK
        varchar username
        varchar full_name
        varchar email
        varchar cell_phone
        varchar area_code
        varchar language
        int2 role_id
        timestamptz last_login
        boolean deleted
        timestamptz created_at
        timestamptz updated_at
    }

    recipient_group {
        uuid group_id PK
        varchar group_name
    }

    recipient_group_member {
        uuid recipient_id PK_FK
        uuid group_id PK_FK
    }

    notifications_task {
        uuid task_id PK
        uuid notification_id FK
        uuid channel_id
        uuid recipient_id FK
        uuid routing_template_id FK
        varchar status
        int4 retry_count
        text content
        timestamptz created_at
        timestamptz updated_at
    }

    delivery_log {
        uuid delivery_log_id PK
        uuid task_id FK
        varchar channel_code
        varchar recipient_contact
        timestamptz sent_at
        varchar status
        varchar provider_response_code
        text provider_response_body
        text error_message
        timestamptz created_at
        uuid correlation_id
    }

    site ||--o{ cell : "has_cells"
    cell ||--o{ cell_session : "monitored_in"
    event_session ||--o{ cell_session : "monitors_cells"
    event ||--o{ event_session : "has_sessions"
    event_type ||--o{ event : "categorizes"
    holiday_occasion ||--o{ event : "links_holiday"
    profile ||--o{ profile_event_session : "links_session"
    event_session ||--o{ profile_event_session : "linked_to_profile"
    profile ||--o{ profile_account : "subscribers"
    account ||--o{ profile_account : "subscribed_to"
    profile ||--o{ profile_channel : "uses_channel"
    channel ||--o{ profile_channel : "used_by_profile"
    channel ||--o{ template : "has_templates"
    profile ||--o{ profile_business_rule_mapping : "has_business_rules"
    business_rule ||--o{ profile_business_rule_mapping : "mapped_to_profile"
    profile ||--o{ notification_event : "triggers_notification_event"
    event ||--o{ notification_event : "originates_from"
    notification ||--o{ notifications_task : "spawns_tasks"
    routing_template ||--o{ notifications_task : "templates_task"
    recipient ||--o{ notifications_task : "destined_for"
    notifications_task ||--o{ delivery_log : "logs_delivery"
    recipient ||--o{ recipient_group_member : "member_of"
    recipient_group ||--o{ recipient_group_member : "contains_recipients"
